{
  "name": "cypress-template",
  "version": "1.0.0",
  "description": "Template for Cypress E2E projects with TypeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobinsonRojas/cypress-template.git"
  },
  "author": "1robinsonrojas@gmail.com",
  "type": "module",
  "scripts": {
    "cy:verify": "cypress verify",
    "cy:open:electron": "cypress open --e2e --browser electron",
    "cy:open:chrome": "cypress open --e2e --browser chrome",
    "cy:run": "cypress run",
    "cy:run:record": "cypress run --record",
    "skills:update": "gh skill update --dir .agents/skills",
    "type:check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "cypress": "^15.19.0",
    "typescript": "^7.0.2",
    "@types/node": "^26.1.1"
  },
  "allowScripts": {
    "cypress@15.19.0": true
  }
}
